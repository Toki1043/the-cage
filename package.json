{
  "name": "the-cage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:stats": "node --experimental-strip-types --no-warnings scripts/verify-stats.ts",
    "verify:determinism": "node --experimental-strip-types --no-warnings scripts/verify-determinism.ts",
    "verify:fight": "node --experimental-strip-types --no-warnings scripts/verify-fight.ts",
    "verify": "npm run verify:stats && npm run verify:fight && npm run verify:concentration && npm run verify:tracked && npm run verify:leaderboard",
    "verify:leaderboard": "node --experimental-strip-types --no-warnings scripts/verify-leaderboard.ts",
    "verify:concentration": "node --experimental-strip-types --no-warnings scripts/verify-concentration.ts",
    "check:concentration": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/check-concentration.ts",
    "check:balance": "node --experimental-strip-types --no-warnings scripts/check-balance.ts",
    "verify:tracked": "node --experimental-strip-types --no-warnings scripts/verify-tracked.ts",
    "check:tracked": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/check-tracked.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "openai": "^7.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5"
  }
}
